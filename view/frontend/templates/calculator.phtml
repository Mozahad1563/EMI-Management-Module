<script type="text/javascript">
    (function () {
        const productPrice = parseFloat("<?= $productPrice ?>");
        const bankData = <?= $bankDataJson ?>;
        
        // Element references
        const triggerText = document.getElementById('emi-trigger-text');
        const viewPlansBtn = document.getElementById('emi-view-plans-btn');
        const modalBackdrop = document.getElementById('emi-modal-backdrop');
        const modalContent = document.getElementById('emi-modal-content');
        const closeModalBtn = document.getElementById('emi-close-modal-btn');
        const bankListContainer = document.getElementById('emi-bank-list');
        const tenureListContainer = document.getElementById('emi-tenure-list');
        
        const modalProductPrice = document.getElementById('emi-modal-product-price');
        const summaryMonthlyPayment = document.getElementById('emi-summary-monthly-payment');
        const summaryBadge = document.getElementById('emi-summary-badge');
        
        const breakdownPrice = document.getElementById('emi-breakdown-price');
        const breakdownInterest = document.getElementById('emi-breakdown-interest');
        const breakdownTotal = document.getElementById('emi-breakdown-total');

        let activeBankId = null;
        let activeTenureMonths = null;

        // Formula Calculation Utility
        function calculateEMIDetails(price, months, rate) {
            const totalInterest = price * rate;
            const totalPayable = price + totalInterest;
            const monthlyInstallment = totalPayable / months;
            return {
                interestCharged: totalInterest,
                totalPayable: totalPayable,
                monthlyInstallment: monthlyInstallment
            };
        }

        // Taka Formatter (Lakh/Crore standard)
        function formatTaka(amount) {
            const rounded = Math.round(amount);
            const formatted = new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 }).format(rounded);
            return '৳' + formatted;
        }

        // Generate Initials if Logo Url is missing
        function getBankInitials(name) {
            return name
                .split(' ')
                .map(w => w[0])
                .join('')
                .slice(0, 3)
                .toUpperCase();
        }

        // Evaluate overall EMI feasibility and starting rate
        function initWidget() {
            let lowestEMI = Infinity;
            let isAnyBankEligible = false;
            let minimumPossibleOrderAmount = Infinity;

            bankData.forEach(bank => {
                if (bank.min_amount < minimumPossibleOrderAmount) {
                    minimumPossibleOrderAmount = bank.min_amount;
                }
                
                // If the product meets the bank's minimum purchase threshold
                if (productPrice >= bank.min_amount) {
                    isAnyBankEligible = true;
                    bank.tenures.forEach(tenure => {
                        const { monthlyInstallment } = calculateEMIDetails(productPrice, tenure.months, tenure.interest_rate);
                        if (monthlyInstallment < lowestEMI) {
                            lowestEMI = monthlyInstallment;
                        }
                    });
                }
            });

            if (isAnyBankEligible && lowestEMI !== Infinity) {
                triggerText.innerHTML = `EMI options available starting from <span class="font-bold text-gray-900">${formatTaka(lowestEMI)}/month</span>.`;
                viewPlansBtn.classList.remove('hidden');
                
                // Setup trigger button click listener
                viewPlansBtn.addEventListener('click', openModal);
            } else {
                // If below order threshold
                triggerText.innerHTML = `EMI available on orders over <span class="font-bold text-gray-900">${formatTaka(minimumPossibleOrderAmount)}</span>.`;
                viewPlansBtn.classList.add('hidden');
            }
        }

        // Modal State Controller
        function openModal() {
            modalBackdrop.classList.remove('pointer-events-none');
            modalBackdrop.classList.add('opacity-100');
            modalContent.classList.remove('translate-y-full', 'sm:translate-y-4', 'opacity-0');
            modalContent.classList.add('translate-y-0', 'sm:translate-y-0', 'opacity-100');
            document.body.style.overflow = 'hidden';

            modalProductPrice.textContent = formatTaka(productPrice);

            // Pre-select first eligible bank
            const firstEligible = bankData.find(b => productPrice >= b.min_amount);
            if (firstEligible) {
                selectBank(firstEligible.bank_id);
            } else {
                renderBanks();
            }
        }

        function closeModal() {
            modalBackdrop.classList.remove('opacity-100');
            modalBackdrop.classList.add('pointer-events-none');
            modalContent.classList.remove('translate-y-0', 'sm:translate-y-0', 'opacity-100');
            modalContent.classList.add('translate-y-full', 'sm:translate-y-4', 'opacity-0');
            document.body.style.overflow = '';
        }

        // Render Bank Partnerships Scroller/Grid
        function renderBanks() {
            bankListContainer.innerHTML = '';
            bankData.forEach(bank => {
                const isDisabled = productPrice < bank.min_amount;
                const isSelected = bank.bank_id === activeBankId;

                const bankCard = document.createElement('div');
                bankCard.className = `p-3 rounded-xl border flex flex-col items-center justify-center text-center cursor-pointer transition-all duration-200 ${
                    isDisabled 
                        ? 'opacity-40 border-slate-800 bg-slate-900/40 pointer-events-none' 
                        : isSelected
                            ? 'border-blue-500 bg-blue-950/30 ring-1 ring-blue-500'
                            : 'border-slate-800 bg-slate-800/40 hover:border-slate-700 hover:bg-slate-800'
                }`;

                // Card Layout
                let logoMarkup = '';
                if (bank.logo_url && bank.logo_url.trim() !== '') {
                    logoMarkup = `<img src="${bank.logo_url}" alt="${bank.bank_name}" class="h-8 max-w-full object-contain mb-2 flex-shrink-0" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />`;
                }
                
                const initialsMarkup = `
                    <div class="w-10 h-10 rounded-full flex items-center justify-center bg-slate-800/80 text-slate-200 font-bold border border-slate-700 mb-2 flex-shrink-0 text-sm" style="${(bank.logo_url && bank.logo_url.trim() !== '') ? 'display:none;' : ''}">
                        ${getBankInitials(bank.bank_name)}
                    </div>
                `;

                bankCard.innerHTML = `
                    ${logoMarkup}
                    ${initialsMarkup}
                    <span class="text-xs font-semibold text-slate-200 break-words w-full">${bank.bank_name}</span>
                    ${isDisabled ? `<span class="text-[9px] text-amber-500/80 mt-1 font-medium">Min order ${formatTaka(bank.min_amount)}</span>` : ''}
                `;

                if (!isDisabled) {
                    bankCard.addEventListener('click', () => selectBank(bank.bank_id));
                }

                bankListContainer.appendChild(bankCard);
            });
        }

        // Render Tenures List Options
        function renderTenures() {
            tenureListContainer.innerHTML = '';
            const bank = bankData.find(b => b.bank_id === activeBankId);
            if (!bank) return;

            bank.tenures.forEach(tenure => {
                const isSelected = tenure.months === activeTenureMonths;
                const chip = document.createElement('button');
                
                chip.className = `px-4 py-2.5 rounded-lg border text-xs font-bold transition-all duration-200 cursor-pointer border-0 ${
                    isSelected
                        ? 'bg-blue-600 hover:bg-blue-700 text-white shadow-lg shadow-blue-600/20'
                        : 'bg-slate-800 hover:bg-slate-700 text-slate-200 border-slate-700'
                }`;
                chip.textContent = `${tenure.months} ${tenure.months === 1 ? 'Month' : 'Months'}`;
                
                chip.addEventListener('click', () => selectTenure(tenure.months));
                tenureListContainer.appendChild(chip);
            });
        }

        // Active State Selection Controllers
        function selectBank(bankId) {
            activeBankId = bankId;
            const bank = bankData.find(b => b.bank_id === bankId);
            
            // Set first available tenure option as default active state
            if (bank && bank.tenures.length > 0) {
                activeTenureMonths = bank.tenures[0].months;
            } else {
                activeTenureMonths = null;
            }

            renderBanks();
            renderTenures();
            updateCalculations();
        }

        function selectTenure(months) {
            activeTenureMonths = months;
            renderTenures();
            updateCalculations();
        }

        // Calculation State Hydration
        function updateCalculations() {
            const bank = bankData.find(b => b.bank_id === activeBankId);
            if (!bank || activeTenureMonths === null) {
                resetCalculationDetails();
                return;
            }

            const tenure = bank.tenures.find(t => t.months === activeTenureMonths);
            if (!tenure) {
                resetCalculationDetails();
                return;
            }

            const { interestCharged, totalPayable, monthlyInstallment } = calculateEMIDetails(
                productPrice,
                tenure.months,
                tenure.interest_rate
            );

            // Populate Breakdown UI
            summaryMonthlyPayment.textContent = formatTaka(monthlyInstallment);
            breakdownPrice.textContent = formatTaka(productPrice);
            breakdownInterest.textContent = formatTaka(interestCharged);
            breakdownTotal.textContent = formatTaka(totalPayable);

            // Interest Badge logic
            if (tenure.interest_rate === 0) {
                summaryBadge.textContent = '0% Interest EMI';
                summaryBadge.className = 'px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wide uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
            } else {
                summaryBadge.textContent = `${Math.round(tenure.interest_rate * 100)}% Regular Interest`;
                summaryBadge.className = 'px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wide uppercase bg-amber-500/10 text-amber-400 border border-amber-500/20';
            }
        }

        function resetCalculationDetails() {
            summaryMonthlyPayment.textContent = formatTaka(0);
            breakdownPrice.textContent = formatTaka(0);
            breakdownInterest.textContent = formatTaka(0);
            breakdownTotal.textContent = formatTaka(0);
            summaryBadge.textContent = 'N/A';
            summaryBadge.className = 'px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wide uppercase bg-slate-800 text-slate-400';
        }

        // Close modal when clicking outside content area (on backdrop)
        modalBackdrop.addEventListener('click', function(e) {
            if (e.target === modalBackdrop) {
                closeModal();
            }
        });

        // Close modal when clicking close button (X)
        closeModalBtn.addEventListener('click', closeModal);

        // Escape key modal closer
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });

        // Initialize widget execution
        initWidget();
    })();
</script>
