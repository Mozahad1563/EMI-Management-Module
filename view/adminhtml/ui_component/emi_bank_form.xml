<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">emi_bank_form.emi_bank_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Bank Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>

    <settings>
        <buttons>
            <button name="back" class="Magento\Cms\Block\Adminhtml\Block\Edit\BackButton"/>
            <button name="delete" class="Magento\Cms\Block\Adminhtml\Block\Edit\DeleteButton"/>
            <button name="save" class="Magento\Cms\Block\Adminhtml\Block\Edit\SaveButton"/>
            <button name="save_and_continue" class="Magento\Cms\Block\Adminhtml\Block\Edit\SaveAndContinueButton"/>
        </buttons>
        <namespace>emi_bank_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>emi_bank_form.emi_bank_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="emi_bank_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="emi_management/bank/save"/>
        </settings>
        <dataProvider class="BrainStation23\EmiManagement\Model\Bank\DataProvider"
                      name="emi_bank_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>

        <field name="id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>

        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Bank Name</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="logo" formElement="fileUploader" sortOrder="20">
            <settings>
                <label translate="true">Logo</label>
                <notice translate="true">Allowed file types: jpg, jpeg, png, gif, svg. Max 2 MB.</notice>
            </settings>
            <formElements>
                <fileUploader>
                    <settings>
                        <uploaderConfig>
                            <param name="url" xsi:type="url" path="emi_management/bank/upload"/>
                        </uploaderConfig>
                        <allowedExtensions>jpg jpeg png gif svg</allowedExtensions>
                        <maxFileSize>2097152</maxFileSize>
                    </settings>
                </fileUploader>
            </formElements>
        </field>

        <field name="status" formElement="select" sortOrder="30">
            <settings>
                <dataType>int</dataType>
                <label translate="true">Status</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="BrainStation23\EmiManagement\Model\Source\Status"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>

    <fieldset name="tenures">
        <settings>
            <label translate="true">Bank Tenures</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>

        <dynamicRows name="tenure_plans" sortOrder="40">
            <settings>
                <addButtonLabel translate="true">Add Tenure</addButtonLabel>
                <additionalClasses>
                    <class name="admin__field-wide">true</class>
                </additionalClasses>
                <componentType>dynamicRows</componentType>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="dataScope" xsi:type="string"/>
                    </item>
                </argument>
                <field name="id" formElement="input">
                    <settings>
                        <dataType>text</dataType>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="months" formElement="input">
                    <settings>
                        <dataType>number</dataType>
                        <label translate="true">Months</label>
                        <validation>
                            <rule name="required-entry" xsi:type="boolean">true</rule>
                            <rule name="validate-digits" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                </field>
                <field name="fee_percentage" formElement="input">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Fee (%)</label>
                        <validation>
                            <rule name="required-entry" xsi:type="boolean">true</rule>
                            <rule name="validate-number" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                </field>
                <field name="status" formElement="select">
                    <settings>
                        <dataType>int</dataType>
                        <label translate="true">Status</label>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <options class="BrainStation23\EmiManagement\Model\Source\Status"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
                <actionDelete name="action_delete">
                    <settings>
                        <contentType>actionDelete</contentType>
                        <label translate="true">Delete</label>
                    </settings>
                </actionDelete>
            </container>
        </dynamicRows>
    </fieldset>
</form>
